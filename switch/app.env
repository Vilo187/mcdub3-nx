# The Switch app's identity: one place for the NRO (hbmenu) and the NSP
# forwarder (home menu). Plain KEY=VALUE, read by switch/build.sh (-> CMake's
# NACP), switch/nsp.sh and CI. Change the version here for a release.

APP_NAME="Midnight Club 3: DUB Edition"
APP_AUTHOR="Laure Ladastra"
APP_VERSION="0.1.0"

# Editions of the game: one NRO each (mcdub3-nx-<edition>.nro, make switch
# EDITION=<edition>) and one NSP forwarder each, starting that NRO from
# sdmc:/switch/mcdub3-nx/. They share one lift (config/xbe_editions.h: the
# discs' code is the same); each NRO looks for its disc in game-<edition>/
# on the card first, then game/. Space-separated.
APP_EDITIONS="usa eur"

# Each forwarder's title ID, APP_TITLE_ID_<edition>: drawn at random in the
# range hacBrewPack recommends (0x0100000000000000-0x01ffffffffffffff), lower
# case, ending in 000 like an application's. Keep them: a new ID installs a
# second app. A new edition gets a fresh random one (not a neighbour: IDs
# after an application's are its add-ons). Optional APP_NAME_<edition>
# names its home-menu entry (default APP_NAME). In the variable names a '-'
# of the edition becomes '_' (pal-es: APP_TITLE_ID_pal_es).
APP_TITLE_ID_usa="010c46f75536e000"     # 2026-10-16, NTSC-U
APP_TITLE_ID_eur="013594aaa6996000"     # 2026-10-24, PAL (Europe)
APP_NAME_eur="Midnight Club 3: DUB Edition (Europe)"

# 256x256 JPEG, no EXIF (hbmenu and the home menu); the default icon if absent.
APP_ICON="assets/cover-art.jpg"

# Start-up logo for the NSP (switch/nsp.sh): NintendoLogo.png (256x128) and
# StartupMovie.gif (256x80) in this folder (personal, gitignored) replace
# NTON's default ones.
APP_LOGO_DIR="assets/logo"

# Where the forwarders find the NROs on the SD card (make switch stages
# them there): <APP_NRO_DIR>/mcdub3-nx-<edition>.nro.
APP_NRO_DIR="sdmc:/switch/mcdub3-nx"

# Pinned sources for switch/nsp.sh (fetched into work/tools, never copied
# into this repo). NTON (rlaphoenix, GPLv3) is the forwarder generator the
# NSP follows: its forwarder program (nx-hbloader + Forwarder-Mod, rebuilt
# for firmware 21, reading the NRO path from romfs:/nextNroPath), its NACP
# settings and icon clean-up, and its start-up logo as the default.
NTON_REPO="https://github.com/rlaphoenix/NTON"
NTON_REF="c5d543a91b7cd1df880f98c9ab831be9a40d024f"
# The original (The-4n) was deleted; this is a mirror of it. GPLv2.
HACBREWPACK_REPO="https://github.com/rlaphoenix/hacBrewPack"
HACBREWPACK_REF="745b16ecfc9ce055743067d200572204cb2aac6c"
