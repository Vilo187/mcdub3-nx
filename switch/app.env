# The Switch app's identity: one place for the NRO (hbmenu) and the NSP
# forwarder (home menu). Plain KEY=VALUE, read by switch/build.sh (-> CMake's
# NACP), switch/nsp.sh and CI. Change the version here for a release.

APP_NAME="Midnight Club 3: DUB Edition"
APP_AUTHOR="Laure Ladastra"
APP_VERSION="0.1.0"

# The forwarder's title ID: ours, drawn at random (2026-10-16) in the range
# hacBrewPack recommends (0x0100000000000000-0x01ffffffffffffff), lower case,
# ending in 000 like an application's. Keep it: a new ID installs a second app.
APP_TITLE_ID="010c46f75536e000"

# 256x256 JPEG, no EXIF (hbmenu and the home menu); the default icon if absent.
APP_ICON="assets/cover-art.jpg"

# Where the forwarder finds the game on the SD card (make switch stages it).
APP_NRO="sdmc:/switch/mcdub3-nx/mcdub3.nro"

# Pinned sources, built in the devkitPro container (switch/nsp.sh).
HBLOADER_REPO="https://github.com/switchbrew/nx-hbloader"
HBLOADER_REF="82b95122c5ae8dc059bf23893ba7623c72c86773"
# The original (The-4n) was deleted; this is a mirror of it. GPLv2.
HACBREWPACK_REPO="https://github.com/rlaphoenix/hacBrewPack"
HACBREWPACK_REF="745b16ecfc9ce055743067d200572204cb2aac6c"
