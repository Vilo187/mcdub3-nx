# Midnight Club 3: DUB Edition -- names and folders (read by tools/env.sh).
MC3_GAME_TITLE="Midnight Club 3: DUB Edition"
MC3_SHORT_NAME="Midnight Club 3"         # app and shortcut names (no colon: Windows)
MC3_APP_DEFAULT=mcdub3               # mcdub3-nx-<edition>.nro, mcdub3_env.txt, mcdub3_log.txt
MC3_SD_DIR_DEFAULT=mcdub3-nx         # sdmc:/switch/mcdub3-nx/
MC3_DISC_PREFIX=game                 # discs in game/ and game-<edition>/
