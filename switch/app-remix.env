# The Remix's Switch app identity (switch/app.env is the DUB Edition's):
# read by switch/build.sh, switch/nsp.sh and CI for GAME=remix. Same keys
# and rules as switch/app.env, see there.

APP_NAME="Midnight Club 3: DUB Edition Remix"
APP_AUTHOR="Laure Ladastra"
APP_VERSION="0.0.1"

# Editions: one NRO each (mcdub3remix-nx-<edition>.nro), from
# sdmc:/switch/mcdub3remix-nx/ (config/remix/xbe_editions.h).
APP_EDITIONS="eur"

# Forwarder title IDs: random, kept (see switch/app.env).
APP_TITLE_ID_eur="01cc7355d6e52000"     # 2026-10-24, PAL (Europe)
APP_NAME_eur="Midnight Club 3: DUB Edition Remix (Europe)"

# 256x256 JPEG, no EXIF; the default icon if absent (personal, gitignored).
APP_ICON="assets/cover-art-remix.jpg"
APP_LOGO_DIR="assets/logo"

APP_NRO_DIR="sdmc:/switch/mcdub3remix-nx"

# Pinned sources for switch/nsp.sh: the same as the DUB Edition's.
NTON_REPO="https://github.com/rlaphoenix/NTON"
NTON_REF="c5d543a91b7cd1df880f98c9ab831be9a40d024f"
HACBREWPACK_REPO="https://github.com/rlaphoenix/hacBrewPack"
HACBREWPACK_REF="745b16ecfc9ce055743067d200572204cb2aac6c"
