# Midnight Club 3: DUB Edition Remix -- names and folders (read by tools/env.sh).
MC3_GAME_TITLE="Midnight Club 3: DUB Edition Remix"
MC3_SHORT_NAME="Midnight Club 3 Remix"   # app and shortcut names (no colon: Windows)
MC3_APP_DEFAULT=mcdub3remix          # mcdub3remix-nx-<edition>.nro, mcdub3remix_env.txt, ...
MC3_SD_DIR_DEFAULT=mcdub3remix-nx    # sdmc:/switch/mcdub3remix-nx/
MC3_DISC_PREFIX=game-remix           # discs in game-remix/ and game-remix-<edition>/
