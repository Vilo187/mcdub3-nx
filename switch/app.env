# What the games' packages share. Each game's own identity (name, version,
# editions, title IDs, artwork, SD folder) is config/<game>/app.env; both
# are read through mc3_app_env (tools/env.sh), this file first.

APP_AUTHOR="Laure Ladastra"

# Pinned sources for switch/nsp.sh (fetched into work-<game>/tools, never
# copied into this repo). NTON (rlaphoenix, GPLv3) is the forwarder
# generator the NSP follows: its forwarder program (nx-hbloader +
# Forwarder-Mod, rebuilt for firmware 21, reading the NRO path from
# romfs:/nextNroPath), its NACP settings and icon clean-up, and its
# start-up logo as the default.
NTON_REPO="https://github.com/rlaphoenix/NTON"
NTON_REF="c5d543a91b7cd1df880f98c9ab831be9a40d024f"
# The original (The-4n) was deleted; this is a mirror of it. GPLv2.
HACBREWPACK_REPO="https://github.com/rlaphoenix/hacBrewPack"
HACBREWPACK_REF="745b16ecfc9ce055743067d200572204cb2aac6c"
